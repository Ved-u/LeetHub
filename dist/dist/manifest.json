{
  "manifest_version": 3,
  "name": "LeetStash",
  "description": "Automatically syncs your Accepted LeetCode solutions to a GitHub repository.",
  "version": "0.1.0",
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/options/index.html",
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "js": [
        "src/content/page-hook.js"
      ],
      "matches": [
        "https://leetcode.com/*"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "js": [
        "src/content/content-script.js"
      ],
      "matches": [
        "https://leetcode.com/*"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "resources": [
        "scenes/*"
      ],
      "use_dynamic_url": false
    }
  ],
  "permissions": [
    "storage",
    "webRequest",
    "notifications",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://leetcode.com/*",
    "https://api.github.com/*",
    "https://github.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://leetcode.com https://raw.githubusercontent.com https://gist.githubusercontent.com https://api.github.com https://github.com https://generativelanguage.googleapis.com https://api.openai.com https://api.anthropic.com"
  }
}
